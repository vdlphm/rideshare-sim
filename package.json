{
  "name": "rideshare-simulation",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.unit.config.ts --passWithNoTests --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "infra:reset": "docker compose -f infra/docker-compose.yml --env-file .env down -v",
    "stack:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f --tail=100"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.20",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "testcontainers": "12.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
