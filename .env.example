# Copy to .env for local use. All values below are fake local placeholders.

# Postgres superuser and per-service role passwords
POSTGRES_PASSWORD=change-me-local
USER_SERVICE_DB_PASSWORD=change-me-local
TRIP_SERVICE_DB_PASSWORD=change-me-local
MATCHING_SERVICE_DB_PASSWORD=change-me-local

# Redis ACL user passwords
REDIS_RIDER_PASSWORD=change-me-local
REDIS_DRIVER_PASSWORD=change-me-local
REDIS_MATCHING_PASSWORD=change-me-local
REDIS_ROUTING_PASSWORD=change-me-local

# Seeded admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local

# Client secrets used to obtain internal service tokens (one per caller)
GATEWAY_CLIENT_SECRET=change-me-local
RIDER_CLIENT_SECRET=change-me-local
DRIVER_CLIENT_SECRET=change-me-local
TRIP_CLIENT_SECRET=change-me-local
MATCHING_CLIENT_SECRET=change-me-local
SIMULATOR_CLIENT_SECRET=change-me-local

# Password shared by all simulator bot accounts (driver-NNN@sim.local, rider-NNN@sim.local), min 8 chars
SIM_BOT_PASSWORD=change-me-local

# Logging (trace|debug|info|warn|error)
LOG_LEVEL=info

# User service
# In compose, DATABASE_URL is built from USER_SERVICE_DB_PASSWORD and KEYS_DIR is the
# user-keys volume (/keys); the two lines below only matter when running outside compose.
# DATABASE_URL=postgres://user_service:change-me-local@localhost:5432/ridesharing
# KEYS_DIR=/tmp/rideshare-keys
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800

# Host port the gateway publishes (the only published port of the stack)
# GATEWAY_HOST_PORT=8080
# Gateway (defaults are the compose service names; override only outside compose)
# PORT=8080
# USER_SERVICE_URL=http://user:3001
# RIDER_SERVICE_URL=http://rider:3002
# DRIVER_SERVICE_URL=http://driver:3003
# TRIP_SERVICE_URL=http://trip:3004
# MATCHING_SERVICE_URL=http://matching:3005
# ROUTING_SERVICE_URL=http://routing:3006
# SIMULATOR_SERVICE_URL=http://simulator:3007
# Upstream response timeout (ms) before the gateway answers 504
PROXY_TIMEOUT_MS=10000
# JWKS cache: refetch interval and minimum gap between unknown-kid refetches (ms)
JWKS_CACHE_MAX_AGE_MS=300000
JWKS_COOLDOWN_MS=30000

# Rider service (compose builds REDIS_URL from REDIS_RIDER_PASSWORD; ACL user `rider`, prefix `rider:`)
# REDIS_URL=redis://rider:change-me-local@localhost:6379/0
# REDIS_KEY_PREFIX=rider:
# Rider position TTL in seconds (refreshed on every location update)
POSITION_TTL_S=600
# Trip service base URL used for ride requests (the rider's token is forwarded)
# TRIP_URL=http://trip:3004

# Driver service (compose builds REDIS_URL from REDIS_DRIVER_PASSWORD; ACL user `driver`, keys `driver:*`)
# REDIS_URL=redis://driver:change-me-local@localhost:6379/0
# REDIS_KEY_PREFIX=driver:
# Drivers with no location update for this long (real ms) are marked OFFLINE by the sweeper
STALE_AFTER_MS=60000
SWEEP_INTERVAL_MS=5000
# Driver -> trip/user (defaults are the compose service names; DRIVER_CLIENT_SECRET is set above)
# TRIP_URL=http://trip:3004
# USER_SERVICE_URL=http://user:3001
# Real ms between reconcile rounds that compare ON_TRIP drivers with the trip service's active trips
# RECONCILE_INTERVAL_MS=30000

# Trip service (compose builds DATABASE_URL from TRIP_SERVICE_DB_PASSWORD; PORT defaults to 3004)
# DATABASE_URL=postgres://trip_service:change-me-local@localhost:5432/ridesharing
# Trip upstreams (defaults are the compose service names) and dispatcher
# USER_SERVICE_URL=http://user:3001
# ROUTING_URL=http://routing:3006
# DRIVER_URL=http://driver:3003
# MATCHING_URL=http://matching:3005
# SIMULATOR_URL=http://simulator:3007
# Real ms between sweeps that re-send old REQUESTED trips to matching
# DISPATCH_SWEEP_MS=10000
# Sim ms a trip must stay REQUESTED before the sweep re-sends it
# DISPATCH_RETRY_AFTER_SIM_MS=15000

# Matching service (compose builds DATABASE_URL from MATCHING_SERVICE_DB_PASSWORD and REDIS_URL from
# REDIS_MATCHING_PASSWORD; ACL user `matching`, keys `matching:*`; PORT defaults to 3005)
# DATABASE_URL=postgres://matching_service:change-me-local@localhost:5432/ridesharing
# REDIS_URL=redis://matching:change-me-local@localhost:6379/0
# REDIS_KEY_PREFIX=matching:
# Upstreams (defaults are the compose service names)
# USER_SERVICE_URL=http://user:3001
# DRIVER_URL=http://driver:3003
# TRIP_URL=http://trip:3004
# ROUTING_URL=http://routing:3006
# SIMULATOR_URL=http://simulator:3007
# Real ms between matching sweeps (offer expiry, lock refresh, waiting jobs)
# SWEEP_INTERVAL_MS=250
# Sim ms a driver has to answer an offer, and sim ms before a job gives up (NO_DRIVERS)
# OFFER_TTL_SIM_MS=15000
# GIVE_UP_SIM_MS=60000
# Real ms TTL of a driver lock (refreshed each sweep while the offer is pending)
# LOCK_TTL_MS=15000
# Min real ms between retries of a job that is waiting for drivers
# IDLE_RETRY_MS=1000

# Simulator bots (compose passes these through; SIM_BOT_PASSWORD is set above)
# SIM_BOTS_ENABLED=true
# Cap on concurrently active rider bots
# SIM_MAX_ACTIVE_RIDERS=100
# Must match matching's OFFER_TTL_SIM_MS: drives the drivers' offer polling rate
# OFFER_TTL_SIM_MS=15000
# Gateway the bots log in through, and (outside compose) routing/user for snapping and service tokens
# SIM_GATEWAY_URL=http://gateway:8080
# GATEWAY_URL=http://gateway:8080
# ROUTING_URL=http://routing:3006
# USER_SERVICE_URL=http://user:3001
