{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Typecheck workspace packages from source so no prior build is needed.
    "paths": { "@rideshare/*": ["./packages/*/src"] }
  },
  "include": [
    "apps/*/src",
    "apps/*/test",
    "packages/*/src",
    "packages/*/test",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "coverage"]
}
